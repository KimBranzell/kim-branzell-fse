{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kim-branzell/faq-section",
	"title": "FAQ Section",
	"category": "design",
	"icon": "editor-help",
	"description": "Frequently Asked Questions section with handpicked FAQ posts displayed in an accordion layout.",
	"supports": {
		"align": ["wide", "full"]
	},
	"attributes": {
		"sectionTitle": {
			"type": "string",
			"default": "Answers to Most Common Questions"
		},
		"sectionSubtitle": {
			"type": "string",
			"default": ""
		},
		"selectedFaqs": {
			"type": "array",
			"default": []
		},
		"ctaText": {
			"type": "string",
			"default": "Can't find your answer?"
		},
		"ctaButtonText": {
			"type": "string",
			"default": "Get in Touch"
		},
		"ctaButtonUrl": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "kb-faq-editor"
}
