{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kim-branzell/about-bento-item",
	"title": "Bento Item",
	"category": "design",
	"icon": "grid-view",
	"description": "A single bento box item within the About Me section.",
	"parent": ["kim-branzell/about"],
	"supports": {
		"reusable": false,
		"html": false
	},
	"attributes": {
		"id": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"content": {
			"type": "string",
			"default": ""
		},
		"size": {
			"type": "string",
			"enum": ["small", "medium", "large"],
			"default": "medium"
		}
	},
	"editorScript": "kb-about-editor"
}
